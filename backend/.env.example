# Copy this file to .env and fill in your values. NEVER commit the real .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Turso (libSQL) database — auth, alerts, sessions, rate limits.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
# OpenWeatherMap key (server-side only — never shipped to the browser).
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DEFAULT_CITY=Bucharest
PORT=8000
# Public URL of the app, used in emails (password reset, alerts).
APP_BASE_URL=https://weatherformoto.bluemouse.cc
# Environment marker. Keep "production" in prod: it hard-disables the insecure
# dev auth-code fallback (see ALLOW_INSECURE_AUTH_CODE below).
APP_ENV=production
# CORS allowlist (comma-separated). The static frontend origin(s). The backend
# also auto-allows *.weatherformoto.pages.dev for Cloudflare Pages previews.
ALLOWED_ORIGINS=https://weatherformoto.bluemouse.cc

# ---------------------------------------------------------------------------
# Cold start / migrations
# ---------------------------------------------------------------------------
# Schema migration runs ~35 serial Turso round trips. It is SKIPPED on normal
# boots (so cold starts are fast). Set to "true" for a ONE-OFF migration run
# after deploying schema changes or provisioning a fresh database, then unset.
RUN_DB_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Auth & sessions
# ---------------------------------------------------------------------------
PBKDF2_ITERATIONS=210000
AUTH_CODE_TTL_MIN=10
SESSION_TTL_DAYS=30
# DEV ONLY. When true AND APP_ENV is not "production", the login code is returned
# in the HTTP response if email cannot be sent. MUST stay false in production.
ALLOW_INSECURE_AUTH_CODE=false

# ---------------------------------------------------------------------------
# Brute-force rate limiting (counters persisted in Turso, table auto-created)
# ---------------------------------------------------------------------------
LOGIN_RATE_MAX=8
LOGIN_RATE_MAX_IP=40
LOGIN_RATE_WINDOW_SEC=900
CODE_MAX_ATTEMPTS=5
VERIFY_RATE_MAX_IP=30
REQCODE_RATE_MAX=5
REQCODE_RATE_MAX_IP=15
REQCODE_RATE_WINDOW_SEC=900

# ---------------------------------------------------------------------------
# Batch alert dispatch — POST /alerts/dispatch-all
# Secret is now sent in the X-Dispatch-Secret HEADER (not the query string).
# Use a long random value. Empty disables the endpoint.
# ---------------------------------------------------------------------------
ALERT_DISPATCH_SECRET=

# ---------------------------------------------------------------------------
# Optional weather sources
# ---------------------------------------------------------------------------
PIRATE_WEATHER_API_KEY=
WEATHERXM_API_KEY=
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
MET_NORWAY_USER_AGENT=WeatherForMoto/1.0 github.com/sa-popescu/WeatherForMoto

# ---------------------------------------------------------------------------
# Email (password reset + email alerts). Use Brevo API OR SMTP.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=weatherformoto@bluemouse.cc

# ---------------------------------------------------------------------------
# Web push (VAPID). Generate a key pair once and keep the private key secret.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:weatherformoto@bluemouse.cc
