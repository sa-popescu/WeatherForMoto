# Copy this file to .env and fill in your values. NEVER commit the real .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Turso (libSQL) database — auth, alerts, sessions, rate limits.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
# OpenWeatherMap key (server-side only — never shipped to the browser).
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DEFAULT_CITY=Bucharest
PORT=8000
# Public URL of the static frontend, used for links back to the app in emails
# (password reset, alerts).
APP_BASE_URL=https://weatherformoto.bluemouse.cc
# Public URL of THIS backend (Cloud Run). Email verification and unsubscribe
# links must reach the API, so they are built from this and not APP_BASE_URL.
API_BASE_URL=https://weatherformoto-1056457771445.europe-west1.run.app
# Environment marker. Keep "production" in prod: it hard-disables the insecure
# dev auth-code fallback (see ALLOW_INSECURE_AUTH_CODE below).
APP_ENV=production
# CORS allowlist (comma-separated). The static frontend origin(s). The backend
# also auto-allows *.weatherformoto.pages.dev for Cloudflare Pages previews.
ALLOWED_ORIGINS=https://weatherformoto.bluemouse.cc

# ---------------------------------------------------------------------------
# Client IP detection (used by every per-IP rate limit)
# ---------------------------------------------------------------------------
# Number of trusted proxies that append to X-Forwarded-For. Cloud Run's front
# end appends exactly one entry, so keep 1 while clients call run.app directly.
TRUSTED_PROXY_HOPS=1
# Trust Cloudflare's CF-Connecting-IP header. Enable ONLY if the backend is
# reachable exclusively through Cloudflare; otherwise clients can forge it.
TRUST_CF_CONNECTING_IP=false

# ---------------------------------------------------------------------------
# Cold start / migrations
# ---------------------------------------------------------------------------
# Schema migration runs ~35 serial Turso round trips. It is SKIPPED on normal
# boots (so cold starts are fast). Set to "true" for a ONE-OFF migration run
# after deploying schema changes or provisioning a fresh database, then unset.
RUN_DB_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Auth & sessions
# ---------------------------------------------------------------------------
# PBKDF2-HMAC-SHA256 rounds for new password hashes (OWASP 2023 guidance).
# Older hashes keep their own count and are upgraded on the next login.
PBKDF2_ITERATIONS=600000
AUTH_CODE_TTL_MIN=10
SESSION_TTL_DAYS=30
# Optional secret mixed into login-code hashes (HMAC-SHA256). Empty keeps plain
# SHA-256. Use a long random value; codes issued before a change stop working.
AUTH_CODE_PEPPER=
# DEV ONLY. When true AND APP_ENV is not "production", the login code is returned
# in the HTTP response if email cannot be sent. MUST stay false in production.
ALLOW_INSECURE_AUTH_CODE=false

# ---------------------------------------------------------------------------
# Brute-force rate limiting (counters persisted in Turso, table auto-created)
# ---------------------------------------------------------------------------
# Login counts FAILED attempts only: per (email, IP) pair and per IP.
LOGIN_RATE_MAX=8
LOGIN_RATE_MAX_IP=40
LOGIN_RATE_WINDOW_SEC=900
# Wrong login-code guesses per (email, IP). After CODE_MAX_FAILURES wrong
# guesses in total (all IPs) the code is invalidated and a new one is needed.
CODE_MAX_ATTEMPTS=5
CODE_MAX_FAILURES=10
# Failed code verifications per email per day, all IPs together. Blocks code
# login only; password login and reset keep working, so no owner lockout.
CODE_FAILURES_PER_EMAIL_DAY=30
# Failed password logins per email per day (all IPs) at which a warning is
# logged. Detection only, no lockout.
PASSWORD_FAILURE_ALERT_DAY=100
VERIFY_RATE_MAX_IP=30
REQCODE_RATE_MAX=5
REQCODE_RATE_MAX_IP=15
REQCODE_RATE_WINDOW_SEC=900
# Hazard reports per user per hour.
HAZARD_RATE_MAX=10
# Manual alert checks (POST /alerts/check-now) per user per hour.
CHECK_NOW_RATE_MAX=10

# ---------------------------------------------------------------------------
# Batch alert dispatch — POST /alerts/dispatch-all
# ---------------------------------------------------------------------------
# Shared secret, sent ONLY in the X-Dispatch-Secret header. Use a long random
# value. Empty disables the endpoint.
ALERT_DISPATCH_SECRET=
# Users processed in parallel by one dispatch run.
DISPATCH_CONCURRENCY=5
# At most one alert per type per user within this many hours, so an ongoing
# condition does not trigger a new alert on every run.
ALERT_COOLDOWN_HOURS=6

# ---------------------------------------------------------------------------
# Optional weather sources
# ---------------------------------------------------------------------------
PIRATE_WEATHER_API_KEY=
WEATHERXM_API_KEY=
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
MET_NORWAY_USER_AGENT=WeatherForMoto/1.0 github.com/sa-popescu/WeatherForMoto

# ---------------------------------------------------------------------------
# Email (verification, password reset, email alerts). Use Brevo API OR SMTP.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=weatherformoto@bluemouse.cc

# ---------------------------------------------------------------------------
# Web push (VAPID). Generate a key pair once and keep the private key secret.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:weatherformoto@bluemouse.cc
