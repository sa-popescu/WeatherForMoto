{
  // Cloudflare Worker that serves the WeatherForMoto static frontend from the
  // edge (built into ./dist by scripts/build-pages.sh). The API stays on Cloud
  // Run and the frontend calls it via CONFIGURED_BACKEND_URL, so the HTML loads
  // instantly even when the Cloud Run backend is cold.
  //
  // The only server code here is the short route links (app/src/worker/shortLinks.ts):
  // POST /s stores a shared ride plan in Workers KV for 90 days, GET /s/<id>
  // redirects to it. `run_worker_first` sends only those two paths to the
  // script; every other request is a static file, served as before.
  "name": "weatherformoto",
  "compatibility_date": "2026-07-01",
  "main": "app/src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/s", "/s/*"]
  },
  // No id: wrangler (4.45 or newer) creates the namespace on the first deploy
  // and keeps it linked afterwards. To pin it, add "id": "<namespace id>"
  // from the Cloudflare dashboard (Storage & Databases, KV).
  "kv_namespaces": [{ "binding": "SHORT_LINKS" }]
}
