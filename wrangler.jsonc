{
  // Cloudflare Worker that serves the Motonor static frontend from the
  // edge (built into ./dist by scripts/build-pages.sh). The API stays on Cloud
  // Run and the frontend calls it via CONFIGURED_BACKEND_URL, so the HTML loads
  // instantly even when the Cloud Run backend is cold.
  //
  // The server code here is the short route links (app/src/worker/shortLinks.ts):
  // POST /s stores a shared ride plan in Workers KV for 90 days, GET /s/<id>
  // redirects to it; the live location of a ride (app/src/worker/live.ts),
  // under /live, kept in Durable Objects for at most 12 hours, and the /l/<id>
  // links riders send; a chat app's preview robot gets the route's or the
  // ride's own title on /s/ and /l/ (app/src/worker/preview.ts); and the old
  // address's redirect (app/src/worker/moved.ts), which sends page loads on
  // weatherformoto.bluemouse.cc to motonor.bluemouse.cc.
  // `run_worker_first` sends only those paths and the pages to the script;
  // every other request is a static file, served as before. A request that
  // matches no file reaches the script too ("not_found_handling": "none"):
  // app/src/worker/staleAssets.ts answers a missing /assets/ file with a plain
  // 404 nobody keeps, and any other page with the app, as the single-page
  // fallback did. The fallback used to answer a file of an older build with
  // the app's page under the year-long cache of /assets/*, which kept that
  // page from ever loading the screen again.
  "name": "weatherformoto",
  "compatibility_date": "2026-07-01",
  "main": "app/src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/s", "/s/*", "/l/*", "/live", "/live/*", "/", "/index.html", "/privacy-policy.html", "/privacy-policy-en.html"]
  },
  // The namespace id is set explicitly. With no id, wrangler's automatic
  // provisioning created the namespace on the first preview build and the
  // production deploy then failed with "a namespace with this account ID and
  // title already exists [code: 10014]" (cloudflare/workers-sdk#14284).
  // Without this binding the Worker answers 503 on /s and the app shares the
  // full link instead.
  "kv_namespaces": [
    { "binding": "SHORT_LINKS", "id": "dd8a399b7b4c49459a5c39a5916e698d" }
  ],
  // Live location: one object per shared ride, one for the daily budget.
  // SQLite storage, the kind the free plan has. The migration runs with the
  // production deploy (wrangler deploy); without these bindings /live answers
  // 503 and the app says sharing is off.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_RIDES", "class_name": "LiveRide" },
      { "name": "LIVE_BUDGET", "class_name": "LiveBudget" }
    ]
  },
  "migrations": [
    { "tag": "live-v1", "new_sqlite_classes": ["LiveRide", "LiveBudget"] }
  ]
}
