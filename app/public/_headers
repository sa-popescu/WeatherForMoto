# Cloudflare static assets: headers for the MotoMeteo frontend.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tilecache.rainviewer.com https://view.eumetsat.int; font-src 'self'; connect-src 'self' https://weatherformoto-1056457771445.europe-west1.run.app https://weatherformoto-ibsofhbewa-ew.a.run.app https://geocoding-api.open-meteo.com https://photon.komoot.io https://api.open-meteo.com https://nominatim.openstreetmap.org https://maps.dwd.de https://view.eumetsat.int https://router.project-osrm.org https://api.rainviewer.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tilecache.rainviewer.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Note: the service worker's own fetches (tile caching) obey connect-src of the
# CSP served with sw.js, so tile hosts must be listed there, not only in img-src.

# The service worker and app shell must always revalidate so releases reach users.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Vite emits content-hashed file names, safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800
